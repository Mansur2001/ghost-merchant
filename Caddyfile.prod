# PRODUCTION Caddyfile — used by docker-compose.prod.yml instead of ./Caddyfile.
#
# Differences from the dev file, all deliberate:
#   * the site is {$DOMAIN} (set DOMAIN in .env), so Caddy fetches a real Let's Encrypt
#     certificate on its own — ports 80 and 443 must be open for that;
#   * NO :8080 plain-HTTP listener. On a public IP it would serve customer addresses, chat and
#     session tokens in the clear;
#   * HSTS is on.
# The privacy policy is served at https://{$DOMAIN}/privacy.html (frontend/user/privacy.html).

{$DOMAIN} {
	encode gzip

	# One line per request, kept across restarts and rebuilds (the caddy_data volume): the
	# backend's own log goes with its container on every deploy, and "it didn't work yesterday"
	# needs yesterday. Same privacy rule as domain/redact.js — the log must not undo the API's:
	# no query strings (search text, tokens), digit runs masked (a phone in a path), no headers.
	# Tiles are skipped below: a map pan is dozens of range reads and would bury everything else.
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 336h
		}
		format filter {
			wrap json
			request>uri regexp \?.* ?…
			request>uri regexp [0-9]{6,} ••••••
			request>headers delete
			resp_headers delete
		}
	}

	# Security headers for the PWA documents. The API sets its own (middleware/securityHeaders.js);
	# these protect the DOM, which is where an injected script would actually do damage —
	# it would sit next to a live session token.
	header {
		# script-src 'self' means NO inline <script> runs: that's why service-worker
		# registration lives in app.js instead of an inline block. Keep it that way.
		# 'unsafe-inline' for styles only, because the markup uses style="" attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# The customer PWA needs geolocation (delivery point) and camera (reference photo);
		# everything else is denied outright.
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), interest-cohort=()"
		# Real domain: browsers remember to use HTTPS only, so a network can't downgrade them.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API -> backend
	handle /api/* {
		reverse_proxy backend:3000
	}

	# WebSocket real-time layer -> backend (Caddy proxies the upgrade automatically)
	handle /ws {
		reverse_proxy backend:3000
	}

	# Shared assets (stylesheet) reachable from all three PWAs.
	handle /shared/* {
		root * /srv/frontend
		file_server
	}
	# The street map: one self-hosted file read with range requests (frontend/shared/map.js).
	# Public data (OpenStreetMap), so any origin may read it — the Android app's WebView is a
	# different origin from this server. Missing file = the apps fall back to a plain grid.
	handle /tiles/* {
		log_skip
		root * /srv
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Headers Range
		header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, ETag"
		header Cache-Control "public, max-age=86400"
		@preflight method OPTIONS
		respond @preflight 204
		file_server
	}

	# Driver PWA
	handle_path /driver/* {
		root * /srv/frontend/driver
		file_server
		try_files {path} /index.html
	}

	# Operator PWA
	handle_path /operator/* {
		root * /srv/frontend/operator
		file_server
		try_files {path} /index.html
	}

	# User PWA (default)
	handle {
		root * /srv/frontend/user
		file_server
		try_files {path} /index.html
	}
}
