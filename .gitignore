# ── Mobile (Capacitor) ──
# The generated web bundle and the native build outputs are derived artifacts; the Android
# project itself IS committed, because it carries hand-edited config (manifest permissions,
# icons, gradle) that must be reviewable and reproducible.
mobile/node_modules/
mobile/www/
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/capacitor-cordova-android-plugins/
*.apk
*.aab
*.keystore
*.jks

# Release signing credentials — never commit.
mobile/android/app/keystore.properties
