# Caddy auto-provisions HTTPS (Let's Encrypt in prod; self-signed local CA on localhost).
# HTTPS is mandatory: Service Workers and navigator.geolocation refuse to run without it.
#
# For a real VPS, replace `localhost` with your domain, e.g. `app.example.com`.

# ── DEV ONLY: plain-HTTP listener for testing on a real phone ────────────────────────────
# An Android WebView will not accept Caddy's self-signed localhost certificate, and you
# cannot get a real cert for 192.168.x.x. So debug builds of the app talk to this port over
# the LAN instead. It serves the same API and the same PWAs.
#
# DELETE THIS BLOCK BEFORE DEPLOYING TO A PUBLIC VPS. On a public IP it would serve customer
# addresses, chat and session tokens in the clear. The app's own network config refuses to
# use cleartext for anything but a private address, but this side must not be left open.
:8080 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:3000
	}
	handle /ws {
		reverse_proxy backend:3000
	}
	handle /shared/* {
		root * /srv/frontend
		file_server
	}
	# The street map: one self-hosted file read with range requests (frontend/shared/map.js).
	# Public data (OpenStreetMap), so any origin may read it — the Android app's WebView is a
	# different origin from this server. Missing file = the apps fall back to a plain grid.
	handle /tiles/* {
		root * /srv
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Headers Range
		header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, ETag"
		header Cache-Control "public, max-age=86400"
		@preflight method OPTIONS
		respond @preflight 204
		file_server
	}
	handle_path /driver/* {
		root * /srv/frontend/driver
		file_server
		try_files {path} /index.html
	}
	handle_path /operator/* {
		root * /srv/frontend/operator
		file_server
		try_files {path} /index.html
	}
	handle {
		root * /srv/frontend/user
		file_server
		try_files {path} /index.html
	}
}

localhost {
	encode gzip

	# Security headers for the PWA documents. The API sets its own (middleware/securityHeaders.js);
	# these protect the DOM, which is where an injected script would actually do damage —
	# it would sit next to a live session token.
	header {
		# script-src 'self' means NO inline <script> runs: that's why service-worker
		# registration lives in app.js instead of an inline block. Keep it that way.
		# 'unsafe-inline' for styles only, because the markup uses style="" attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# The customer PWA needs geolocation (delivery point) and camera (reference photo);
		# everything else is denied outright.
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), interest-cohort=()"
		# Uncomment on a REAL domain. Never on localhost: it pins your dev browser to HTTPS
		# for a year and is a genuine pain to undo.
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		# App files are checked with the server on every load (a 304 when unchanged): without
		# it browsers guess them fresh for hours and an update can reach the cache stale. The
		# `?` keeps any value already set — /tiles sets its own day-long cache, the API its own.
		?Cache-Control "no-cache"
	}

	# API -> backend
	handle /api/* {
		reverse_proxy backend:3000
	}

	# WebSocket real-time layer -> backend (Caddy proxies the upgrade automatically)
	handle /ws {
		reverse_proxy backend:3000
	}

	# Shared assets (stylesheet) reachable from all three PWAs.
	handle /shared/* {
		root * /srv/frontend
		file_server
	}
	# The street map: one self-hosted file read with range requests (frontend/shared/map.js).
	# Public data (OpenStreetMap), so any origin may read it — the Android app's WebView is a
	# different origin from this server. Missing file = the apps fall back to a plain grid.
	handle /tiles/* {
		root * /srv
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Headers Range
		header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, ETag"
		header Cache-Control "public, max-age=86400"
		@preflight method OPTIONS
		respond @preflight 204
		file_server
	}

	# Driver PWA
	handle_path /driver/* {
		root * /srv/frontend/driver
		file_server
		try_files {path} /index.html
	}

	# Operator PWA
	handle_path /operator/* {
		root * /srv/frontend/operator
		file_server
		try_files {path} /index.html
	}

	# User PWA (default)
	handle {
		root * /srv/frontend/user
		file_server
		try_files {path} /index.html
	}
}
