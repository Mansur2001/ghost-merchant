// Ghost Merchant data model.
//
// ⚠️ THIS FILE IS NOT THE WHOLE SCHEMA. Prisma cannot express several things this system
// depends on, and they live as raw SQL inside the migrations instead:
//
//   * PARTIAL UNIQUE INDEXES — `messages.client_id WHERE client_id IS NOT NULL` is what makes
//     a replayed offline message land exactly once. Lose it and the offline queue silently
//     duplicates chat. Same for `refunds` (one open refund per order).
//   * PARTIAL INDEXES for hot queries: the outbox relay's pending set, active operators.
//   * CHECK CONSTRAINTS on order_photos.kind and orders.total_amount.
//
// If you ever regenerate this database from schema.prisma alone, those are gone. Always go
// through the migrations. `npm run db:verify` checks they are present.
//
// Field names stay snake_case deliberately: rows are returned to the PWAs largely as-is, so
// camelCasing them here would change the API contract and every frontend that reads it.

generator client {
  provider = "prisma-client-js"
  // The runtime image is node:20-alpine, so the musl engine has to be generated alongside the
  // host one — otherwise `prisma generate` on macOS produces a client the container cannot
  // load, and it fails at runtime rather than at build time.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Customers are identified purely by phone number (invariant 4).
model User {
  phone_number String   @id
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  orders       Order[]

  @@map("users")
}

model Driver {
  id         BigInt   @id @default(autoincrement())
  name       String
  msisdn     String   @unique
  pin_hash   String
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  orders     Order[]

  @@map("drivers")
}

/// Named operator accounts. `active` is toggled rather than rows deleted — the audit trail
/// references operators by id, and deleting one orphans every action they ever took.
model Operator {
  id                   BigInt    @id @default(autoincrement())
  username             String    @unique
  display_name         String
  password_hash        String
  active               Boolean   @default(true)
  must_change_password Boolean   @default(false)
  last_login_at        DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  created_by           String?

  @@map("operators")
}

model Order {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_phone    String
  status        order_status @default(PENDING_PAYMENT)
  total_amount  Decimal      @db.Decimal(12, 2)
  items         Json         @default("[]")
  lat           Float?
  lng           Float?
  landmark_text String
  driver_id     BigInt?
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)

  driver       Driver?       @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User          @relation(fields: [user_phone], references: [phone_number], onDelete: NoAction, onUpdate: NoAction)
  messages     Message[]
  order_events OrderEvent[]
  order_photos OrderPhoto[]
  transactions Transaction[]
  refunds      Refund[]

  @@index([driver_id], map: "idx_orders_driver")
  @@index([status], map: "idx_orders_status")
  @@index([user_phone], map: "idx_orders_user")
  @@map("orders")
}

/// Verified payment receipts parsed from telecom SMS by the Android Oracle.
/// telecom_receipt_id UNIQUE is the anti-double-spend guarantee (invariant 2).
model Transaction {
  id                 BigInt   @id @default(autoincrement())
  order_id           String?  @db.Uuid
  telecom_receipt_id String   @unique
  sender_msisdn      String
  amount             Decimal  @db.Decimal(12, 2)
  raw_sms            String?
  matched            Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  // Which rail this arrived on (evcplus, zelle, cashapp, …). The Oracle senses any of them.
  provider           String?
  // US rails identify people by DISPLAY NAME, not phone number, so there is nothing to match
  // an order against automatically. The name is recorded so the operator's reconcile queue
  // says "Zelle · John Smith · $25.00" instead of an anonymous amount.
  sender_name        String?

  order Order? @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_transactions_order")
  @@index([sender_msisdn, amount], map: "idx_tx_sender_amount")
  @@map("transactions")
}

/// In-app coordination chat. `client_id` is the offline queue's idempotency key — see the
/// PARTIAL UNIQUE INDEX note at the top of this file.
model Message {
  id         BigInt   @id @default(autoincrement())
  order_id   String   @db.Uuid
  sender     String
  body       String
  client_id  String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id, created_at], map: "idx_messages_order")
  @@map("messages")
}

/// Append-only audit of every state transition. `actor` names a person for operators
/// (`operator:<id>:<username>`), which is what a payment dispute is resolved with.
model OrderEvent {
  id          BigInt        @id @default(autoincrement())
  order_id    String        @db.Uuid
  from_status order_status?
  to_status   order_status
  actor       String
  note        String?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id, created_at], map: "idx_order_events_order")
  @@map("order_events")
}

/// Photo metadata; the bytes live in MinIO. object_key is UNIQUE and deterministic per
/// (order, kind), so a re-upload overwrites rather than accumulating copies of a customer's
/// home or goods.
model OrderPhoto {
  id           BigInt   @id @default(autoincrement())
  order_id     String   @db.Uuid
  kind         String
  object_key   String   @unique
  content_type String?
  uploaded_by  String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, kind], map: "idx_order_photos_order")
  @@map("order_photos")
}

/// One live login challenge per phone. Re-requesting replaces it atomically, which is how
/// the resend cooldown is enforced without a race.
model OtpCode {
  phone        String   @id
  code_hash    String
  expires_at   DateTime @db.Timestamptz(6)
  attempts     Int      @default(0)
  last_sent_at DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([expires_at], map: "idx_otp_expires")
  @@map("otp_codes")
}

/// Transactional outbox: event rows written in the same transaction as the state change they
/// describe, relayed after commit. `id` is also the ordering key.
model Outbox {
  id           BigInt    @id @default(autoincrement())
  event_name   String
  payload      Json
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  published_at DateTime? @db.Timestamptz(6)
  attempts     Int       @default(0)
  last_error   String?
  failed       Boolean   @default(false)

  @@map("outbox")
}

/// Manual refund ledger.
///
/// The platform never custodies customer money (invariant 6), so a refund is an operator
/// sending funds back from their own phone, off platform. That is correct — but without a
/// record, "which customers are we still out of pocket to?" is answerable only from a chat
/// history, and a refund that never got sent is invisible until the customer complains.
///
/// FAILED_REFUND transition -> a row with status 'owed'
/// operator sends the money -> 'settled', with the telecom reference of the RETURN transfer
model Refund {
  id                   BigInt    @id @default(autoincrement())
  order_id             String    @db.Uuid
  amount               Decimal   @db.Decimal(12, 2)
  reason               String?
  status               String    @default("owed")
  settled_at           DateTime? @db.Timestamptz(6)
  settled_by           String?
  settlement_reference String?
  settlement_note      String?
  created_by           String
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "idx_refunds_created")
  @@map("refunds")
}

/// Requests to be given an operator or driver account.
///
/// NOBODY SELF-REGISTERS. Anyone who could create their own operator account could read every
/// customer's phone number, address, chat and photos — so this table holds a REQUEST, and an
/// existing operator decides. Approving is what creates the real account; this row only ever
/// records that someone asked.
///
/// Deliberately minimal: a name, a number to call back on, and what they want. Collecting an
/// address or an ID up front would be data we can't protect and don't need to decide.
model AccessRequest {
  id           BigInt    @id @default(autoincrement())
  role         String    // 'driver' | 'operator'
  name         String
  phone        String    // canonical E.164
  message      String?
  status       String    @default("new") // 'new' | 'contacted' | 'approved' | 'declined'
  // ID document held in MinIO. This is the most sensitive data in the system — a leaked
  // government ID is identity theft, not an inconvenience — so only the KEY is stored here,
  // the bytes never leave object storage except streamed to an authenticated operator, and
  // the object is DESTROYED the moment the decision it supports is made. Keeping it after
  // that is pure liability with no purpose.
  // Front AND back: the back carries the machine-readable zone, expiry and issuing details,
  // and a front-only photo is trivially a picture of someone else's card.
  id_front_key     String?
  id_back_key      String?
  id_document_at   DateTime? @db.Timestamptz(6)
  reviewed_at  DateTime? @db.Timestamptz(6)
  reviewed_by  String?
  review_note  String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_access_requests_created")
  @@map("access_requests")
}

/// Outbound SMS waiting for the Oracle phone to send.
///
/// WHY A QUEUE INSTEAD OF CALLING THE PHONE: the phone cannot accept inbound connections. On
/// mobile data it sits behind carrier-grade NAT, and on WiFi behind a router — so a backend
/// on a VPS can never open a socket to it without a VPN or tunnel, which is exactly the extra
/// dependency this project exists to avoid. Inverting it costs nothing: the Oracle already
/// polls for incoming messages, so it polls for outgoing ones on the same tick.
///
/// PLAINTEXT WARNING: `body` contains a live login code. The hashed copy in otp_codes is the
/// real record; this row exists only long enough to be delivered and is DELETED on
/// confirmation, with a sweep for anything the phone never collected. Codes must not
/// accumulate at rest.
model SmsOutbox {
  id         BigInt    @id @default(autoincrement())
  to         String
  body       String
  status     String    @default("pending") // 'pending' | 'sending' | 'failed'
  attempts   Int       @default(0)
  last_error String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  claimed_at DateTime? @db.Timestamptz(6)

  @@index([created_at], map: "idx_sms_outbox_pending")
  @@map("sms_outbox")
}

enum order_status {
  PENDING_PAYMENT
  PAID_UNASSIGNED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED_REFUND
}
