# ── Backend ──────────────────────────────────────────────
# Local development uses `development`. Set `production` only on the real VPS — it turns on
# the prod guardrails (seed refuses to run, OTP refuses the log transport, no stack traces).
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to hit the API / open sockets.
# The native app runs from http(s)://localhost inside the WebView — keep those two,
# and ADD your real domain for production.
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost
# Production only: the public domain Caddy serves and fetches a certificate for
# (Caddyfile.prod, used by docker-compose.prod.yml). Unused in local dev.
# DOMAIN=app.example.com

# ── PostgreSQL ───────────────────────────────────────────
# Prisma reads DATABASE_URL directly (the CLI can't see config.js). Host name is the compose
# service, so this is the in-network address — not the one the host-side CLI uses.
#
# ⚠️ These names are baked into the postgres_data volume the FIRST time it initializes.
# Changing them later does NOT rename an existing database — the backend will boot and fail to
# connect. On a stack that predates the GuriKaabe rename (database `ghost_merchant`, user
# `ghost`), either keep the old values here, or migrate deliberately:
#   docker compose exec postgres psql -U ghost -d postgres \
#     -c 'ALTER DATABASE ghost_merchant RENAME TO gurikaabe;' \
#     -c 'ALTER ROLE ghost RENAME TO gurikaabe;'
# Locally you can instead throw the volume away and reseed: docker compose down -v && …
DATABASE_URL=postgresql://gurikaabe:change_me_strong_password@postgres:5432/gurikaabe?schema=public
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gurikaabe
POSTGRES_USER=gurikaabe
POSTGRES_PASSWORD=change_me_strong_password

# ── MinIO (S3-compatible, self-hosted) ───────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=gurikaabe-documents
S3_ACCESS_KEY=gurikaabe_minio_access
S3_SECRET_KEY=change_me_minio_secret
S3_FORCE_PATH_STYLE=true
# MinIO AIStor license FILE (not the key itself). Git-ignored. Default: ./minio.license
# MINIO_LICENSE_FILE=./minio.license

# ── Security ─────────────────────────────────────────────
# Signing secret for ALL session tokens (customer / driver / operator). Rotating this logs
# everyone out immediately — that is the intended panic button.
SESSION_SECRET=change_me_another_long_random_hex
# Creates the first ADMIN operator ("admin") on an empty database, flagged must-change. At least
# 12 characters. Use a NEW value in production — the backend refuses to boot while any of the
# dev seed's public passwords (CREDENTIALS.md) still logs in.
OPERATOR_PASSWORD=change_me_operator_password

# ── Customer login (OTP over SMS) ────────────────────────
# How login passcodes reach the customer:
#   clicksend - real SMS via ClickSend for every number (+252 and +1). PRODUCTION SETTING.
#   auto   - same as clicksend, but with no ClickSend credentials a dev box falls back to log.
#   log    - print the code to the server log. DEV ONLY: anyone with log access can log in
#            as any customer. The backend REFUSES TO BOOT with this set and NODE_ENV=production.
OTP_TRANSPORT=log
OTP_SEND_TIMEOUT_MS=10000


# ClickSend — sends every login code, Somali and international (https://dashboard.clicksend.com).
# Pay-as-you-go, no monthly fee.
#   CLICKSEND_USERNAME   your ClickSend username (the email you signed up with)
#   CLICKSEND_API_KEY    Dashboard -> Developers -> API Credentials. Keep it secret: it can
#                        send messages billed to you.
#   CLICKSEND_FROM       optional sender. US carriers block unregistered senders, so to reach
#                        +1 numbers reliably use a VERIFIED TOLL-FREE number from ClickSend
#                        (+18XXXXXXXXX). Blank = ClickSend's shared sender.
# Check before trusting the app: node scripts/sms-preflight.mjs --send +1XXXXXXXXXX
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=
# Outside production, real SMS goes ONLY to these numbers (comma-separated, your own test
# handsets). Every other number gets the on-screen dev code — the seed's numbers are valid
# Somali numbers that may belong to real people. Ignored in production.
DEV_SMS_ALLOWLIST=

# Play review login — ONE number whose code is REVIEW_CODE (6 digits) instead of an SMS, so a
# Google reviewer can sign in. Put both in the Console's "App access" notes. Leave blank to
# disable. Use a number nobody else will register; it is a real customer account.
REVIEW_PHONE=
REVIEW_CODE=

# ── Owner contact (public) ───────────────────────────────
# Shown on the access-request page so someone who can't use the form can reach a person.
OWNER_NAME=GuriKaabe
OWNER_EMAIL=tukale206@gmail.com
OWNER_PHONE=+1 206 687 6538

# ── Payment wallets (USSD) ───────────────────────────────
# The customer picks a wallet; its button opens the dialer with that network's code and YOUR
# merchant number for it already filled in. Money goes straight to that number — an operator
# confirms each payment by checking the matching merchant phone.
#
# A wallet appears ONLY when both of its lines are set. There are no defaults on purpose: a
# guessed code or placeholder number would send a customer's money nowhere. Half-set or
# malformed = the backend refuses to boot and says which line is wrong.
#
#   <WALLET>_MERCHANT  the Somali number that receives this wallet's payments
#   <WALLET>_USSD      the send-money code. {NUM} = merchant number, {AMT} = amount.
#                      End it in %23, never a bare # (Android cuts the dial string at #).
#
# Get each code from that network, then dial it BY HAND once with a small amount before
# turning it on. EVC Plus below is the code this app has always used.
EVC_MERCHANT=
EVC_USSD=
# e.g. EVC_USSD=*712*{NUM}*{AMT}%23
EDAHAB_MERCHANT=
EDAHAB_USSD=
ZAAD_MERCHANT=
ZAAD_USSD=
SAHAL_MERCHANT=
SAHAL_USSD=

# ── Redis (optional) ─────────────────────────────────────
# Unset  = single-instance mode: in-process event bus and rate limiter.
# Set    = the bus fans events across instances and rate limits are shared. REQUIRED before
#          running more than one backend container, or clients on instance B miss instance A's
#          events and the effective rate limit becomes N x max.
REDIS_URL=redis://redis:6379

