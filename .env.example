# ── Backend ──────────────────────────────────────────────
# Local development uses `development`. Set `production` only on the real VPS — it turns on
# the prod guardrails (seed refuses to run, OTP refuses the log transport, no stack traces).
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to hit the API / open sockets.
# The native app runs from http(s)://localhost inside the WebView — keep those two,
# and ADD your real domain for production.
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# ── PostgreSQL ───────────────────────────────────────────
# Prisma reads DATABASE_URL directly (the CLI can't see config.js). Host name is the compose
# service, so this is the in-network address — not the one the host-side CLI uses.
DATABASE_URL=postgresql://ghost:change_me_strong_password@postgres:5432/ghost_merchant?schema=public
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ghost_merchant
POSTGRES_USER=ghost
POSTGRES_PASSWORD=change_me_strong_password

# ── MinIO (S3-compatible, self-hosted) ───────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ghost-documents
S3_ACCESS_KEY=ghost_minio_access
S3_SECRET_KEY=change_me_minio_secret
S3_FORCE_PATH_STYLE=true

# ── Security ─────────────────────────────────────────────
# Shared secret between the Android Oracle and the backend for HMAC webhook signing.
ORACLE_WEBHOOK_SECRET=change_me_long_random_hex
# Signing secret for ALL session tokens (customer / driver / operator). Rotating this logs
# everyone out immediately — that is the intended panic button.
SESSION_SECRET=change_me_another_long_random_hex
# Single super-user (operator/dispatcher) password.
OPERATOR_PASSWORD=change_me_operator_password

# ── Customer login (OTP over SMS) ────────────────────────
# How login passcodes reach the customer:
#   log    - print the code to the server log. DEV ONLY: anyone with log access can log in
#            as any customer. The backend REFUSES TO BOOT with this set and NODE_ENV=production.
#   oracle - real SMS sent by the Oracle phone (termux-sms-send) over your own SIM.
#            Needs NO address for the phone: a phone can't accept inbound connections (carrier
#            NAT / a router), so the backend queues the message and the phone polls for it,
#            authenticated with ORACLE_WEBHOOK_SECRET. Nothing to configure here.
OTP_TRANSPORT=log
OTP_SEND_TIMEOUT_MS=10000

# Twilio — carries SMS to NON-Somali numbers only (your US test handset, and a Play reviewer
# who has to receive a login code). Somali numbers keep going through the Oracle phone, so
# this is not a dependency the Somali business relies on.
#
# Get these from https://console.twilio.com after signing up:
#   TWILIO_ACCOUNT_SID   starts with AC...
#   TWILIO_AUTH_TOKEN    keep this secret; it can send messages billed to you
#   TWILIO_FROM          a Twilio number you own, in +1XXXXXXXXXX form
# On a TRIAL account you must also verify your own number in the console before it can
# receive messages (error 21608 means you skipped that step).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: use a Messaging Service instead of a bare from-number.
TWILIO_MESSAGING_SERVICE_SID=

# ── Owner contact (public) ───────────────────────────────
# Shown on the access-request page so someone who can't use the form can reach a person.
OWNER_NAME=GuriKaabe
OWNER_EMAIL=tukale206@gmail.com
OWNER_PHONE=+1 206 687 6538

# ── Payment / USSD ───────────────────────────────────────
# Merchant number that receives EVC Plus / eDahab P2P transfers.
MERCHANT_MSISDN=61XXXXXXX
# USSD template. {NUM} = merchant number, {AMT} = amount. Trailing # is encoded as %23.
USSD_TEMPLATE=*712*{NUM}*{AMT}%23
# Telecom Sender IDs the Oracle listens to (comma-separated).
TELECOM_SENDER_IDS=EVCPlus,Somtel

# ── Oracle health ────────────────────────────────────────
# Alert the operator if no heartbeat is seen within this many seconds.
ORACLE_HEARTBEAT_TIMEOUT_SECONDS=180

# ── Redis (optional) ─────────────────────────────────────
# Unset  = single-instance mode: in-process event bus and rate limiter.
# Set    = the bus fans events across instances and rate limits are shared. REQUIRED before
#          running more than one backend container, or clients on instance B miss instance A's
#          events and the effective rate limit becomes N x max.
REDIS_URL=redis://redis:6379

# ── Payment sensing over email (optional) ────────────────
# The Oracle's job without the phone: US rails (Zelle, Cash App, Venmo) email the same
# notification they text, and the server can read a mailbox directly — no Android device, no
# APK, no permissions. Somali rails still need the phone; they text, they don't email.
#
# Gmail needs an APP PASSWORD, not your normal password — see docs/EMAIL_SENSOR_SETUP.md.
# Leave blank to keep the sensor off.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=30
IMAP_LOOKBACK_HOURS=24
